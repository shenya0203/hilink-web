config globals 'globals'
    option mmx_mask '0x3F00'
    option local_source 'lan'
    option net_select '0'
    option keepalive_period '10'
	option keepalive_ip1 '223.5.5.5'
	option keepalive_ip2 '223.6.6.6'

# =======================
# 1. 接口设置 (Interfaces)
# =======================

config interface 'wan'
    option enabled '1'
    list track_ip '223.5.5.5'
    list track_ip '223.6.6.6'
    option reliability '1'
    option count '3'
    option timeout '2'
    option interval '10'
    option down '3'
    option up '3'

config interface 'wwan'  # 新增: WIFI 接口 (请确认名称是否正确)
    option enabled '1'
    list track_ip '223.5.5.5'
    list track_ip '223.6.6.6'
    option reliability '1'
    option count '3'
    option timeout '2'
    option interval '10'
    option down '3'
    option up '3'

config interface 'lte'
    option enabled '1'
    list track_ip '223.5.5.5'
    list track_ip '223.6.6.6'
    option reliability '1'
    option count '3'
    option timeout '2'
    option interval '10'
    option down '3'
    option up '3'

# =======================
# 2. 成员设置 (Members)
# =======================

# --- 有线 (WAN) 成员 ---
config member 'wan_m1'   # 优先级最高
    option interface 'wan'
    option metric '1'
    option weight '1'

config member 'wan_m2'   # 优先级中 (给4G让路时用)
    option interface 'wan'
    option metric '2'
    option weight '1'

# --- WIFI (WWAN) 成员 ---
config member 'wwan_m2'  # 优先级中 (跟在有线后面)
    option interface 'wwan'
    option metric '2'
    option weight '1'

config member 'wwan_m3'  # 优先级低 (垫底)
    option interface 'wwan'
    option metric '3'
    option weight '1'

# --- 4G (LTE) 成员 ---
config member 'lte_m1'   # 优先级最高 (4G优先时用)
    option interface 'lte'
    option metric '1'
    option weight '1'

config member 'lte_m3'   # 优先级低 (保底用)
    option interface 'lte'
    option metric '3'
    option weight '1'

# =======================
# 3. 策略设置 (Policies)
# =======================

# 策略 A: 【有线/WiFi 优先】
# 逻辑: 有线(1) > WiFi(2) > 4G(3)
# 只要有线通，就走有线；有线断了走WiFi；都断了走4G
config policy 'policy_wired_wifi_pri'
    list use_member 'wan_m1'
    list use_member 'wwan_m2'
    list use_member 'lte_m3'

# 策略 B: 【4G 优先】
# 逻辑: 4G(1) > 有线(2) > WiFi(3)
# 只要4G通，就走4G；4G断了才回落到 有线/WiFi 组
config policy 'policy_lte_pri'
    list use_member 'lte_m1'
    list use_member 'wan_m2'
    list use_member 'wwan_m3'

config policy 'policy_eth_only'
    list use_member 'wan_m1'

# =======================
# 4. 规则设置 (Rules)
# =======================

config rule 'default_rule'
    option dest_ip '0.0.0.0/0'
    option proto 'all'
    option sticky '0'
    # 这里决定当前生效的模式：
    # 填 'policy_wired_wifi_pri' = 有线/WiFi优先
    # 填 'policy_lte_pri'        = 4G优先
    option use_policy 'policy_wired_wifi_pri'