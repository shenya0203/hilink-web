#!/bin/sh

# --- 配置部分 ---
DEVICE="/dev/ttyUSB1"        
INTERFACE="lte"              
INFO_FILE="/tmp/modem_info.json" 
CHECK_INTERVAL=10            
FAIL_THRESHOLD=3             

# --- 全局变量初始化 ---
fail_count=0
# 静态信息缓存
g_imei=""
g_iccid=""
g_imsi=""

# --- 辅助函数：发送 AT 指令 ---
send_at() {
    local cmd="$1"
    local output=""
    local line=""
    
    exec 3<>"$DEVICE"
    if flock -n 3; then
        echo -e "${cmd}\r" >&3
        while read -t 1 -u 3 line; do
            line=$(echo "$line" | tr -d '\r')
            if [ -z "$line" ]; then continue; fi
            if [ -n "$output" ]; then
                output="${output}\n${line}"
            else
                output="${line}"
            fi
            if echo "$line" | grep -q -E "OK$|ERROR$"; then
                break
            fi
        done
    else
        echo "串口忙，跳过" >&2
    fi
    exec 3>&-
    echo -e "$output"
}

# --- 尝试获取静态信息 ---
try_get_static_info() {
    if [ -z "$g_imei" ]; then
        resp=$(send_at "AT+CGSN")
        val=$(echo "$resp" | grep -E "[0-9]{15}" | head -n 1)
        if [ -n "$val" ]; then g_imei="$val"; logger -t "Modem-Monitor" "Got IMEI: $g_imei"; fi
    fi
    if [ -z "$g_imsi" ]; then
        resp=$(send_at "AT+CIMI")
        val=$(echo "$resp" | grep -E "[0-9]{15}" | head -n 1)
        if [ -n "$val" ]; then g_imsi="$val"; logger -t "Modem-Monitor" "Got IMSI: $g_imsi"; fi
    fi
    if [ -z "$g_iccid" ]; then
        resp=$(send_at "AT+QCCID")
        if echo "$resp" | grep -q "+QCCID:"; then
            val=$(echo "$resp" | grep "+QCCID:" | awk -F ': ' '{print $2}' | tr -d '\r')
        else
            resp=$(send_at "AT+ICCID")
            val=$(echo "$resp" | grep "+ICCID:" | awk -F ': ' '{print $2}' | tr -d '\r')
        fi
        if [ -n "$val" ] && [ ${#val} -gt 10 ]; then g_iccid="$val"; logger -t "Modem-Monitor" "Got ICCID: $g_iccid"; fi
    fi
}

# --- 更新状态文件 (新增 ip 参数) ---
update_status_file() {
    local sig="$1"
    local net="$2"
    local stat="$3"
    local sim_st="$4"
    local ip="$5"  # 新增 IP 参数
    
    cat <<EOF > "${INFO_FILE}.tmp"
{
    "imei": "${g_imei:-N/A}",
    "iccid": "${g_iccid:-N/A}",
    "imsi": "${g_imsi:-N/A}",
    "signal": "$sig",
    "network_type": "$net",
    "status": "$stat",
    "sim_status": "$sim_st",
    "local_ip": "$ip",
    "updated": "$(date +%s)"
}
EOF
    mv "${INFO_FILE}.tmp" "${INFO_FILE}"
}

# --- 主程序开始 ---
logger -t "Modem-Monitor" "Service started..."

while [ ! -c "$DEVICE" ]; do
    logger -t "Modem-Monitor" "Waiting for $DEVICE..."
    sleep 5
done

stty -F "$DEVICE" 115200 raw -echo min 0 time 10
send_at "ATE0"
send_at "AT+CMEE=2"

while true; do
    try_get_static_info

    # 初始化变量
    signal_str="No Signal"
    net_type="None"
    net_status="Unknown"
    sim_status="unknown"
    local_ip="0.0.0.0" # 默认 IP

    # 1. 检查 SIM 状态
    cpin_resp=$(send_at "AT+CPIN?")
    
    if echo "$cpin_resp" | grep -q "READY"; then
        sim_status="ready"
        
        # 2. 获取信号
        csq_line=$(send_at "AT+CSQ" | grep "+CSQ:")
        csq_val=$(echo "$csq_line" | awk -F '[,: ]+' '{print $2}')
        if [ -n "$csq_val" ] && [ "$csq_val" -ne 99 ]; then
             signal_dbm=$((-113 + csq_val * 2))
             signal_str="${signal_dbm} dBm"
        fi

        # 3. 获取注册状态
        cereg_resp=$(send_at "AT+CEREG?" | grep "+CEREG:")
        reg_stat=$(echo "$cereg_resp" | awk -F ',' '{print $2}' | tr -d '\r')
        
        # 4. 获取网络类型
        cops_resp=$(send_at "AT+COPS?" | grep "+COPS:")
        if echo "$cops_resp" | grep -q "7"; then net_type="LTE"; elif echo "$cops_resp" | grep -q "9"; then net_type="NR5G"; else net_type="LTE"; fi

        is_online=0
        case "$reg_stat" in
            1|5) 
                is_online=1
                net_status="Registered"
                
                # 5. --- 新增：获取 IP 地址 ---
                # 发送 AT+CGPADDR=1
                ip_resp=$(send_at "AT+CGPADDR=1")
                # 解析 +CGPADDR: 1,"10.x.x.x"
                # grep 提取包含引号的行，awk -F '"' 取第二个字段 (即引号中间的内容)
                ip_val=$(echo "$ip_resp" | grep "+CGPADDR:" | awk -F '"' '{print $2}')
                
                if [ -n "$ip_val" ]; then
                    local_ip="$ip_val"
                fi
                ;;
            2) net_status="Searching" ;;
            *) net_status="Not Registered ($reg_stat)" ;;
        esac

        # 更新 JSON
        update_status_file "$signal_str" "$net_type" "$net_status" "$sim_status" "$local_ip"

        if [ "$is_online" -eq 1 ]; then
            fail_count=0
        else
            fail_count=$((fail_count + 1))
        fi

    else
        # SIM 异常处理
        sim_raw=$(echo "$cpin_resp" | grep "+CPIN:" | awk -F ': ' '{print $2}' | tr -d '\r')
        sim_status="${sim_raw:-absent}"
        
        update_status_file "0" "None" "SIM Error" "$sim_status" "0.0.0.0"
        
        fail_count=$((fail_count + 1))
        logger -t "Modem-Monitor" "SIM not ready: $sim_status. Count: $fail_count"
    fi

    # 故障重启逻辑
    if [ "$fail_count" -ge "$FAIL_THRESHOLD" ]; then
        logger -t "Modem-Monitor" "Connection lost. Restarting $INTERFACE..."
        ifdown "$INTERFACE"
        sleep 3
        ifup "$INTERFACE"
        fail_count=0
        sleep 20
    fi

    sleep "$CHECK_INTERVAL"
done