#!/bin/sh

# --- 配置部分 ---
DEVICE="/dev/ttyUSB1"        # 模组 AT 串口
INTERFACE="lte"              # OpenWrt 接口名称
INFO_FILE="/tmp/modem_info.json" # 状态输出文件，供 Web UI 读取
CHECK_INTERVAL=10            # 循环检测周期(秒)
FAIL_THRESHOLD=3             # 连续失败几次重启接口

# --- 变量初始化 ---
fail_count=0
imei=""
iccid=""
imsi=""

# --- 辅助函数：发送 AT 指令 ---
send_at() {
    local cmd="$1"
    # 使用 lock 防止和 hotplug 脚本冲突
    # timeout 2s 防止卡死
    (
        # -n 表示 Non-blocking (不等待)
        if flock -n 200; then
            echo -e "${cmd}\r" > "$DEVICE"
        else
            echo "串口忙，跳过" >&2
        fi
    ) 200>/var/lock/modem_serial.lock
    # 读取返回 (简单的读取方式，生产环境可用 microcom 或 chat)
    head -n 10 "$DEVICE" 2>/dev/null
}

get_static_info() {
    # 1. 获取 IMEI
    resp=$(send_at "AT+GSN")
    imei=$(echo "$resp" | grep -E "^[0-9]{15}" | tr -d '\r')
    
    # 2. 获取 IMSI (CIMI)
    resp=$(send_at "AT+CIMI")
    imsi=$(echo "$resp" | grep -E "^[0-9]{15}" | tr -d '\r')
    
    # 3. 获取 ICCID (不同厂家指令可能不同，常见为 AT+QCCID 或 AT+CCID)
    resp=$(send_at "AT+QCCID") 
    # 如果 AT+QCCID 不行，尝试 AT+CCID
    if ! echo "$resp" | grep -q "+QCCID:"; then
         resp=$(send_at "AT+CCID")
         iccid=$(echo "$resp" | grep "+CCID:" | awk -F ': ' '{print $2}' | tr -d '\r')
    else
         iccid=$(echo "$resp" | grep "+QCCID:" | awk -F ': ' '{print $2}' | tr -d '\r')
    fi
}

update_status_file() {
    local sig="$1"
    local net="$2"
    local stat="$3"
    
    # 生成 JSON 格式写入 /tmp/，方便 UI 读取
    # 使用临时文件写入再移动，防止 UI 读取时文件不完整
    cat <<EOF > "${INFO_FILE}.tmp"
{
    "imei": "$imei",
    "iccid": "$iccid",
    "imsi": "$imsi",
    "signal": "$sig",
    "network_type": "$net",
    "status": "$stat",
    "updated": "$(date +%s)"
}
EOF
    mv "${INFO_FILE}.tmp" "${INFO_FILE}"
}

# --- 主循环 ---
logger -t "Modem-Monitor" "Service started for $INTERFACE on $DEVICE"

# 等待串口出现
while [ ! -e "$DEVICE" ]; do sleep 5; done

# 获取一次静态信息
get_static_info
logger -t "Modem-Monitor" "Info: IMEI=$imei ICCID=$iccid"

while true; do
    # 1. 检查 SIM 卡状态
    cpin=$(send_at "AT+CPIN?" | grep "+CPIN:")
    
    if echo "$cpin" | grep -q "READY"; then
        # SIM 卡正常，查询信号 (CSQ)
        # 返回格式 +CSQ: 20,99
        csq_line=$(send_at "AT+CSQ" | grep "+CSQ:")
        csq_val=$(echo "$csq_line" | awk -F '[,: ]+' '{print $2}')
        
        # 将 CSQ 换算成 dBm (粗略估算: -113 + csq * 2)
        if [ -n "$csq_val" ] && [ "$csq_val" -ne 99 ]; then
             signal_dbm=$((-113 + csq_val * 2))
             signal_str="${signal_dbm} dBm ($csq_val)"
        else
             signal_str="No Signal"
        fi

        # 检查注册状态
        cereg=$(send_at "AT+CEREG?" | grep "+CEREG:")
        reg_stat=$(echo "$cereg" | awk -F ',' '{print $2}' | tr -d '\r')
        
        is_online=0
        case "$reg_stat" in
            1|5) is_online=1; net_status="Registered" ;;
            2) net_status="Searching..." ;;
            *) net_status="Not Registered ($reg_stat)" ;;
        esac

        # 更新状态文件
        update_status_file "$signal_str" "LTE" "$net_status"
        
        # --- Watchdog 逻辑 ---
        # 如果注册成功，重置失败计数
        if [ "$is_online" -eq 1 ]; then
            fail_count=0
        else
            # 注册失败，增加计数
            fail_count=$((fail_count + 1))
            logger -t "Modem-Monitor" "Network abnormal. Fail count: $fail_count/$FAIL_THRESHOLD"
        fi

    else
        update_status_file "0" "None" "SIM Error"
        fail_count=$((fail_count + 1))
        logger -t "Modem-Monitor" "SIM Error! Fail count: $fail_count/$FAIL_THRESHOLD"
    fi

    # 2. 故障恢复
    if [ "$fail_count" -ge "$FAIL_THRESHOLD" ]; then
        logger -t "Modem-Monitor" "Threshold reached. Restarting interface $INTERFACE..."
        
        # 调用 netifd 接口重启
        ifdown "$INTERFACE"
        sleep 3
        ifup "$INTERFACE"
        
        # 重置计数，等待下一次循环
        fail_count=0
        # 如果需要，这里可以 sleep 长一点等待拨号
        sleep 20
    fi

    sleep "$CHECK_INTERVAL"
done
